macro package pkg2

import std.ast.*
import pkg1.*


public macro Prop(input: Tokens): Tokens {
    let v = parseDecl(input)
    @getIdent[ident](input)

    return quote(
        $(input)
        public prop $(ident): $(decl.declType) {
            get() {
                this.$(v.identifier)
            }
        }
    )
}
