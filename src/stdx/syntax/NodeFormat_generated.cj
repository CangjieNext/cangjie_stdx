 struct NodeFormat_Position {
    static let BYTE_ALIGNMENT: UInt32 = 4

    let fileId: UInt32
    let line: Int32
    let column: Int32

    init() {
        fileId = 0
        line = 0
        column = 0
    }

    init(
        fileId: UInt32,
        line: Int32,
        column: Int32) {
        this.fileId = fileId
        this.line = line
        this.column = column
    }

    init(buf: Array<UInt8>, pos: UInt32) {
        boundsCheck(buf, Int64(pos + 12))
        fileId = getUInt32(buf[Int64(pos + 0)..Int64(pos + 0 + 4)])
        line = getInt32(buf[Int64(pos + 4)..Int64(pos + 4 + 4)])
        column = getInt32(buf[Int64(pos + 8)..Int64(pos + 8 + 4)])
    }
}

func createNodeFormat_Position(builder: Builder, obj: NodeFormat_Position)
{
    builder.prep(4, 12)
    builder.prependInt32(obj.column)
    builder.prependInt32(obj.line)
    builder.prependUInt32(obj.fileId)
    return builder.offset()
}

