    static func startExpr(builder: Builder): Unit { builder.startObject(3) }
    static func addBase(base: UInt32, builder: Builder) {
        builder.prependUOffsetTSlot(0, base, 0)
    }
    static func addExprType(exprType: NodeFormat_AnyExpr, builder: Builder) {
        builder.prependUInt8Slot(1, EnumNodeFormat_AnyExprValues(exprType), 0)
    }
    static func addExpr(expr: UInt32, builder: Builder) {
        builder.prependUOffsetTSlot(2, expr, 0)
    }
    static func endExpr(builder: Builder): UInt32 {return builder.endObject()}
    static func createExpr(
        builder: Builder,
        base: UInt32,
        exprType: NodeFormat_AnyExpr,
        expr: UInt32
    ): UInt32 {
        NodeFormat_Expr.startExpr(builder)
        NodeFormat_Expr.addExpr(expr, builder)
