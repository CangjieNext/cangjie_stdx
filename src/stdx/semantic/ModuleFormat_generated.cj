 struct PackageFormat_Position {
    static let BYTE_ALIGNMENT: UInt32 = 4

    let file: UInt32
    let pkgId: UInt32
    let line: Int32
    let column: Int32
    let ignore: Bool

    init() {
        file = 0
        pkgId = 0
        line = 0
        column = 0
        ignore = false
    }

    init(
        file: UInt32,
        pkgId: UInt32,
        line: Int32,
        column: Int32,
        ignore: Bool) {
        this.file = file
        this.pkgId = pkgId
        this.line = line
        this.column = column
        this.ignore = ignore
    }

    init(buf: Array<UInt8>, pos: UInt32) {
        boundsCheck(buf, Int64(pos + 20))
        file = getUInt32(buf[Int64(pos + 0)..Int64(pos + 0 + 4)])
        pkgId = getUInt32(buf[Int64(pos + 4)..Int64(pos + 4 + 4)])
        line = getInt32(buf[Int64(pos + 8)..Int64(pos + 8 + 4)])
        column = getInt32(buf[Int64(pos + 12)..Int64(pos + 12 + 4)])
        ignore = getBool(buf[Int64(pos + 16)..Int64(pos + 16 + 1)])
    }
}

func createPackageFormat_Position(builder: Builder, obj: PackageFormat_Position)
{
    builder.prep(4, 20)
    builder.pad(3)
    builder.prependBool(obj.ignore)
    builder.prependInt32(obj.column)
    builder.prependInt32(obj.line)
    builder.prependUInt32(obj.pkgId)
    builder.prependUInt32(obj.file)
    return builder.offset()
}

 struct PackageFormat_DeclHash {
    static let BYTE_ALIGNMENT: UInt32 = 8

    let instVar: UInt64
    let virt: UInt64
    let sig: UInt64
    let srcUse: UInt64
    let bodyHash: UInt64

    init() {
        instVar = 0
        virt = 0
        sig = 0
        srcUse = 0
        bodyHash = 0
    }

    init(
        instVar: UInt64,
        virt: UInt64,
        sig: UInt64,
        srcUse: UInt64,
        bodyHash: UInt64) {
        this.instVar = instVar
        this.virt = virt
        this.sig = sig
        this.srcUse = srcUse
        this.bodyHash = bodyHash
    }

    init(buf: Array<UInt8>, pos: UInt32) {
        boundsCheck(buf, Int64(pos + 40))
        instVar = getUInt64(buf[Int64(pos + 0)..Int64(pos + 0 + 8)])
        virt = getUInt64(buf[Int64(pos + 8)..Int64(pos + 8 + 8)])
        sig = getUInt64(buf[Int64(pos + 16)..Int64(pos + 16 + 8)])
        srcUse = getUInt64(buf[Int64(pos + 24)..Int64(pos + 24 + 8)])
        bodyHash = getUInt64(buf[Int64(pos + 32)..Int64(pos + 32 + 8)])
    }
}

func createPackageFormat_DeclHash(builder: Builder, obj: PackageFormat_DeclHash)
{
    builder.prep(8, 40)
    builder.prependUInt64(obj.bodyHash)
    builder.prependUInt64(obj.srcUse)
    builder.prependUInt64(obj.sig)
    builder.prependUInt64(obj.virt)
    builder.prependUInt64(obj.instVar)
    return builder.offset()
}

